// Prisma schema file

generator client {
  provider = "prisma-client-js"
  output   = "../src/lib/generated/client"
}

datasource db {
  provider = "sqlite"
}

model User {
  id         String   @id
  email      String   @unique
  name       String?
  provider   String? // e.g. "google", "apple", "facebook"
  providerId String?  @unique // unique id from the provider
  tokens     Int      @default(10) // Initial tokens for a new user
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  songs      Song[]
}

model Song {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String     @unique // link to youtube/spotify
  title     String // Name of the song
  genre     String
  slug      String     @unique // short id for sharing (e.g. x7y2)
  feedbacks Feedback[]
  isActive  Boolean    @default(true) // FFU
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId]) // index for improving performance of retrieval by user
}

model Feedback {
  id          String   @id @default(uuid())
  songId      String
  song        Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  lyrics      Int // 1-5
  composition Int // 1-5
  production  Int // 1-5
  overall     Int // 1-5
  comment     String
  createdAt   DateTime @default(now())

  @@index([songId])
}
